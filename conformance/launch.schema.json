{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brewlet.sh/schemas/launch-v2.json",
  "title": "Brewlet 2 launch descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "process"],
  "properties": {
    "schemaVersion": {"const": 2},
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint"],
      "properties": {
        "entrypoint": {"type":"array","minItems":1,"prefixItems":[{"type":"string","minLength":1,"pattern":"^[^\\u0000]*$"}],"items":{"type":"string","pattern":"^[^\\u0000]*$"}},
        "args": {"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"}},
        "workingDir": {"type":"string","pattern":"^/[^\\u0000]*$"},
        "env": {
          "type":"array",
          "description":"Names must additionally be unique; enforced by the shared parser.",
          "items": {
            "type":"object",
            "additionalProperties":false,
            "required":["name","value"],
            "properties": {
              "name":{"type":"string","minLength":1,"pattern":"^[^=\\u0000]+$","not":{"const":"PATH"}},
              "value":{"type":"string","pattern":"^[^\\u0000]*$"}
            }
          }
        }
      }
    },
    "requires": {
      "type":"object",
      "additionalProperties":false,
      "properties": {
        "runtimeImages": {
          "type":"array",
          "uniqueItems":true,
          "items":{"type":"string","maxLength":55,"pattern":"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"}
        }
      }
    }
  }
}
