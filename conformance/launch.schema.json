{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brewlet.sh/schemas/launch-v1.json",
  "title": "Brewlet version-1 launch descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "process"],
  "properties": {
    "schemaVersion": {"const": 1},
    "process": {
      "type": "object",
      "additionalProperties": false,
      "description": "command and args form the application command portion after the fixed runtime image ENTRYPOINT. Omitting both inherits the runtime image CMD; an explicitly empty value clears it.",
      "properties": {
        "command": {"type":"array","prefixItems":[{"type":"string","minLength":1,"pattern":"^[^\\u0000]*$"}],"items":{"type":"string","pattern":"^[^\\u0000]*$"}},
        "args": {"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"}},
        "workingDir": {"type":"string","pattern":"^/[^\\u0000]*$"},
        "env": {
          "type":"array",
          "description":"Names must additionally be unique; enforced by the shared parser.",
          "items": {
            "type":"object",
            "additionalProperties":false,
            "required":["name","value"],
            "properties": {
              "name":{"type":"string","minLength":1,"pattern":"^[^=\\u0000]+$","not":{"const":"PATH"}},
              "value":{"type":"string","pattern":"^[^\\u0000]*$"}
            }
          }
        }
      }
    }
  }
}
