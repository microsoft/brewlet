{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["runtimeClass"],
  "properties": {
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "imagePullPolicy", "allowWrite", "publicURL", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "allowWrite": {"type": "boolean"},
        "publicURL": {"type": "string", "pattern": "^$|^https://[^/@?#\\s]+/?$"},
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {"type": "object", "additionalProperties": {"$ref": "#/definitions/nonnegativeQuantity"}},
            "limits": {"type": "object", "additionalProperties": {"$ref": "#/definitions/nonnegativeQuantity"}}
          }
        }
      }
    },
    "runtimeClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overhead"],
      "properties": {
        "overhead": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {"$ref": "#/definitions/nonnegativeQuantity"},
            "memory": {"$ref": "#/definitions/nonnegativeQuantity"}
          }
        }
      }
    }
  },
  "definitions": {
    "nonnegativeQuantity": {
      "description": "A nonnegative Kubernetes resource Quantity string; the API server remains authoritative for resource validation.",
      "type": "string",
      "pattern": "^\\+?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+|[numkMGTPE]|[KMGTPE]i)?$"
    }
  }
}
